    "build": "vite build",
    "postbuild": "node ./scripts/remove-unused-public-build-assets.mjs && node ./scripts/compress-build.mjs",
    "assets:startup": "node ./scripts/optimize-startup-assets.mjs",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "test:talents": "node ./scripts/test-talent-tree.mjs",
    "preview": "vite preview",
    "build:admin": "vite build --mode admin --outDir dist-admin",
    "start:pvp": "vite --host 127.0.0.1 --port 4184 --strictPort",
